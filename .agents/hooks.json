{
  "safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$input | Out-Null; Write-Output '{\\\"decision\\\":\\\"allow\\\"}'\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "post-build-verify": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$input | Out-Null; Write-Output '{}'\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
