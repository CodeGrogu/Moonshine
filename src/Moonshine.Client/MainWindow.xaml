<Window
    x:Class="Moonshine.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Moonshine - Ultra-Low-Latency PC Streaming Platform (Windows 11)">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Navigation View -->
        <NavigationView
            x:Name="MainNav"
            Grid.Row="0"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            SelectionChanged="OnNavigationSelectionChanged"
            Loaded="OnNavLoaded">
            
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Host Server" Tag="Host" Icon="Remote" />
                <NavigationViewItem Content="Client Streamer" Tag="Client" Icon="Play" />
                <NavigationViewItem Content="Acceptance Centre" Tag="Acceptance" Icon="Accept" />
                <NavigationViewItem Content="Hardware Diagnostics" Tag="Diagnostics" Icon="Diagnostic" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Margin="16" />
        </NavigationView>

        <!-- Global Status Bar -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="0" Text="Moonshine Engine Ready - Direct3D 11 AVX2 Accelerated" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="Windows 11 x64 | v0.5.6-alpha" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
