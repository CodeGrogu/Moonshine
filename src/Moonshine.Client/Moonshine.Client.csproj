<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Moonshine</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moonshine.Protocol\Moonshine.Protocol.csproj" />
    <ProjectReference Include="..\Moonshine.Interop\Moonshine.Interop.csproj" />
    <ProjectReference Include="..\Moonshine.Core\Moonshine.Core.csproj" />
    <ProjectReference Include="..\Moonshine.Host\Moonshine.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- STUB: This GameStream-only client engine is retained as migration reference and excluded from the single-application product executable. -->
    <Compile Remove="MoonshineClientEngine.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
