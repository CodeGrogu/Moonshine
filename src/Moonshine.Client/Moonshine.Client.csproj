    <TargetFramework>net9.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Moonshine.Client</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moonshine.Protocol\Moonshine.Protocol.csproj" />
    <ProjectReference Include="..\Moonshine.Interop\Moonshine.Interop.csproj" />
