<Application
    x:Class="Moonshine.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" xmlns:converters="using:Moonshine.UI.Converters" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" xmlns:converters="using:Moonshine.UI.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
