<Page
    x:Class="Moonshine.UI.Views.AcceptancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Moonshine.UI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Left">

            <!-- Title & Execution State -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Two-Device Production Acceptance Centre" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Authoritative E2E production qualification workflow (TODO-049 / TODO-050)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="VERDICT:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.OverallVerdict, Mode=OneWay}" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Role Selection & Target Endpoint -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Header="Acceptance Role" SelectedValue="{x:Bind ViewModel.AcceptanceRole, Mode=TwoWay}" VerticalAlignment="Bottom">
                        <ComboBoxItem Content="Client" IsSelected="True" />
                        <ComboBoxItem Content="Host" />
                    </ComboBox>

                    <TextBox Grid.Column="1" Header="Target Host IP" Text="{x:Bind ViewModel.HostAddress, Mode=TwoWay}" VerticalAlignment="Bottom" />
                    <TextBox Grid.Column="2" Header="Port" Text="{x:Bind ViewModel.Port, Mode=TwoWay}" VerticalAlignment="Bottom" />

                    <Button Grid.Column="3" Content="Start Acceptance Run" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.StartAcceptanceRunCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- Status Banner -->
            <InfoBar IsOpen="True" IsClosable="False"
                     Severity="Informational"
                     Title="Status"
                     Message="{x:Bind ViewModel.StatusText, Mode=OneWay}" />

            <!-- Interactive Human Observation Card (Visible during human prompt step) -->
            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16"
                    Visibility="{x:Bind ViewModel.IsHumanPromptActive, Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Text="MANDATORY OPERATOR CONFIRMATION" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="Please evaluate physical presentation on this device and record explicit confirmation:" />

                    <CheckBox Content="Video Quality: Live stream is sharp and free of tearing or stutter" IsChecked="{x:Bind ViewModel.VideoSharp, Mode=TwoWay}" />
                    <CheckBox Content="Audio Quality: Host audio playback is clear without glitching" IsChecked="{x:Bind ViewModel.AudioAudible, Mode=TwoWay}" />
                    <CheckBox Content="Input Latency: Remote mouse/keyboard interaction is responsive" IsChecked="{x:Bind ViewModel.InputResponsive, Mode=TwoWay}" />

                    <TextBox Header="Observer Comments / Provenance Notes" Text="{x:Bind ViewModel.OperatorNotes, Mode=TwoWay}" PlaceholderText="Enter optional operator verification notes" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Confirm Observation (PASS)" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConfirmObservationCommand}" />
                        <Button Content="Decline / Fail Step" Command="{x:Bind ViewModel.DeclineObservationCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 10-Step Acceptance Execution Matrix -->
            <StackPanel Spacing="8">
                <TextBlock Text="Acceptance Test Execution Matrix" Style="{ThemeResource SubtitleTextBlockStyle}" />
                
                <ListView ItemsSource="{x:Bind ViewModel.Steps}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AcceptanceStepDisplayItem">
                            <Grid Padding="12,8" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind StepNumber}" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind StepName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Status}" VerticalAlignment="Center" Foreground="#00E5FF" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Duration}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind EvidenceSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Generated Acceptance Report Document Viewer -->
            <StackPanel Spacing="8">
                <TextBlock Text="Synthesized Production Acceptance Report" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <TextBox Text="{x:Bind ViewModel.ReportMarkdown, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             MinHeight="200"
                             MaxHeight="400" />
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
