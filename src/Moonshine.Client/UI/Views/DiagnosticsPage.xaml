<Page
    x:Class="Moonshine.UI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Moonshine.UI.ViewModels"
    xmlns:sys="using:System"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Hardware Diagnostics &amp; Engine Probe" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Physical GPU, hardware encoder/decoder, WASAPI audio, and SIMD instruction sets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh Probe" Command="{x:Bind ViewModel.RefreshDiagnosticsCommand}" VerticalAlignment="Center" />
            </Grid>

            <ListView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HardwareInfoItem">
                        <Grid Padding="16,12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Category}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Property}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Value}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Live Application Logs -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Live Application Logs" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Real-time structured streaming events and diagnostics trace" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Open Logs Folder" Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
                    <Button Content="Copy Logs" Command="{x:Bind ViewModel.CopyLogsCommand}" />
                    <Button Content="Clear Logs" Command="{x:Bind ViewModel.ClearLogsCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Height="300">
                <ListView ItemsSource="{x:Bind ViewModel.LogEntries}"
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sys:String">
                            <TextBlock Text="{x:Bind}"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
