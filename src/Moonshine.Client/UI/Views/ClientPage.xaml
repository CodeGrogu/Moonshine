<Page
    x:Class="Moonshine.UI.Views.ClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Connection Bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Header="Host IP Address" Text="{x:Bind ViewModel.HostAddress, Mode=TwoWay}" PlaceholderText="192.168.48.92" />
            <TextBox Grid.Column="1" Header="Control Port" Text="{x:Bind ViewModel.Port, Mode=TwoWay}" PlaceholderText="48011" />

            <Button Grid.Column="2" Content="Discover Hosts" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.DiscoverHostsCommand}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />

            <Button Grid.Column="3" Content="Connect" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.ConnectCommand}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />

            <Button Grid.Column="4" Content="Disconnect" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.DisconnectCommand}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
        </Grid>

        <!-- Video Presentation Surface & Telemetry HUD -->
        <Border Grid.Row="1" Background="Black" CornerRadius="8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <!-- Real Direct3D 11 SwapChainPanel -->
                <SwapChainPanel x:Name="VideoSwapChainPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                <!-- Disconnected Placeholder Placeholder View -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsConnected, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <FontIcon Glyph="&#xE768;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Live Performance Telemetry HUD Overlay -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16"
                        Background="#CC1E1E1E" CornerRadius="6" Padding="12,8"
                        Visibility="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MOONSHINE STREAM HUD" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" />
                        <TextBlock Text="{x:Bind ViewModel.DecodedFps, Mode=OneWay, ConverterParameter='FPS: {0}', Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.JitterMs, Mode=OneWay, ConverterParameter='Jitter: {0} ms', Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.PacketLossCount, Mode=OneWay, ConverterParameter='Lost: {0} pkts', Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.FecRecoveriesCount, Mode=OneWay, ConverterParameter='FEC: {0} recovered', Converter={StaticResource StringFormatConverter}}" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Controls & Quick Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Request Keyframe (IDR)" Command="{x:Bind ViewModel.RequestIdrKeyframeCommand}" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
