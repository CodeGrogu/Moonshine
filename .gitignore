# ======================================================================
.idea/
*.DotSettings.user
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ======================================================================
# 3. C++ / CMake / Ninja / Compilers
# ======================================================================
build/
build-*/
build_x64/
build_arm64/
cmake-build-*/
out/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
*.ninja
*.ninja_deps
*.ninja_log
*.cmake
!CMakeLists.txt
!CMakePresets.json
!cmake/*.cmake

# Compiled Object files & Static/Dynamic Libraries
*.obj
*.o
*.lib
*.a
*.la
*.lo
*.exp
*.ilk
*.pdb
*.idb
*.d
*.dll
*.so
*.so.*
*.dylib
*.exe

# Precompiled Headers
*.gch
*.pch

# Clang / Clang-Tidy / Bear
compile_commands.json
.cache/
*.plist

# ======================================================================
