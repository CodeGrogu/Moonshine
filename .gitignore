*.vssscc
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
ARM/
ARM64/
ipch/
*.opendb
*.VC.db

# MSBuild Binary Log & Structured Log
*.binlog
*.rsp

# ======================================================================
